{
  "name": "vmax-engine-root",
  "version": "0.1.0",
  "private": true,
  "description": "VMax: a vector search engine in TypeScript, built from first principles.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.core.json && tsc --noEmit -p packages/core/tsconfig.node.json && tsc --noEmit -p tools/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "dataset-info": "tsx tools/scripts/dataset-info.ts",
    "bench:distance": "tsx tools/scripts/bench-distance.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
